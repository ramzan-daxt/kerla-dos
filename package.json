{
  "name": "kerla-dos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "ios:sync": "next build --webpack && cap sync ios",
    "ios:open": "cap open ios",
    "build": "next build --webpack",
    "start": "npx serve out",
    "test": "npm run test:web",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:web": "node scripts/test-web.mjs",
    "test:ios": "node --test tests/ios-config.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:web && npm run build"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.4.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
